          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="JSR223 Sampler - work with extracted variable" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters">v_token</stringProp>
            <stringProp name="script">

// Step 1: Read the passed variable from token extracted from sign on pg
def myToken = vars.get(&quot;v_token&quot;)
//log.info(&quot;this is my token*****&quot;)  //write to log file in jmeter bin


SampleResult.setResponseData(&quot;Write my token extracted from the signon page == &quot; + myToken, &quot;UTF-8&quot;)   //shows in &quot;response data&quot; tab of listner (view results tree)
SampleResult.setResponseMessage(&quot;**** Lous message succesfull **********&quot;)  //shows in &quot;sample result&quot; tab of listner (view results tree)
SampleResult.setSuccessful(true) //fails sampler when false -- passes when true







</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Sampler>
