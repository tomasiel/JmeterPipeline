          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="JSR223 Sampler - Extract a value from a response" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">

// The full text
def response = &quot;Angelo Gianni Tomasiello&quot;


// Define left and right boundaries
def left = &quot;Angelo &quot;
def right = &quot; Tomasiello&quot;

// Find start and end index
def start = response.indexOf(left)
def end = response.indexOf(right, start + left.length())

// Extract value
def result = &quot;&quot;
if (start != -1 &amp;&amp; end != -1) {
    result = response.substring(start + left.length(), end)
}

// Output
SampleResult.setResponseData(&quot;Extracted value: ${result}&quot;, &quot;UTF-8&quot;)
SampleResult.setSuccessful(true)

</stringProp>
          </JSR223Sampler>
